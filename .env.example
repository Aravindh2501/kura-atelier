# ---- Payments (modules/payments) -------------------------------------------
# Razorpay (https://dashboard.razorpay.com → Settings → API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → URL: https://YOUR-DOMAIN/api/payments/webhook/razorpay
# Events: payment.captured, payment.failed. Paste the secret you choose here:
RAZORPAY_WEBHOOK_SECRET=

# Cash on delivery (default: on)
COD_ENABLED=true
# Test-mode "demo" gateway. Default: on only when Razorpay keys are missing and NODE_ENV != production
# PAYMENTS_DEMO=true

# ---- Orders (modules/orders) ------------------------------------------------
# Needed to call PATCH /api/orders/<id> (move an order to shipped, add tracking). 16+ characters.
ORDERS_ADMIN_TOKEN=
# Where the JSON order store lives (default: ./.data/orders.json)
# ORDERS_DB_PATH=
